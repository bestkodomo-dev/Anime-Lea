local function ClaimAvailableDailyRewards()
    local dailyRewards = Omni.Shared and Omni.Shared.DailyRewards
    local dailyData = Omni.Data and Omni.Data.DailyRewards
    if typeof(dailyRewards) ~= "table" or typeof(dailyData) ~= "table"
        or typeof(dailyData.Claimed) ~= "table" then
        return
    end

    local start = dailyData.Start
    if typeof(start) ~= "number" then
        warn("[WarpFarm] ข้อมูลเวลาเริ่ม Daily Rewards ไม่ถูกต้อง")
        return
    end

    local lastAvailableDay = 1
    if start > 0 then
        lastAvailableDay = math.floor((workspace:GetServerTimeNow() - start) / 86400) + 1
    end

    local availableDayCount = math.min(lastAvailableDay, #dailyRewards)
    for dayIndex = 1, availableDayCount do
        local dayKey = tostring(dayIndex)
        if dailyData.Claimed[dayKey] == true then
            requestedDailyRewards[dayKey] = nil
            continue
        end
        if requestedDailyRewards[dayKey]
            and os.clock() - requestedDailyRewards[dayKey] < dailyRewardRetryInterval then
            continue
        end

        requestedDailyRewards[dayKey] = os.clock()
        local claimOk, claimError = pcall(function()
            Omni.Signal:Fire("General", "DailyRewards", "Claim", dayIndex)
        end)
        if not claimOk then
            requestedDailyRewards[dayKey] = nil
            warn("[WarpFarm] รับ Daily Reward วันที่ " .. dayKey .. " ไม่สำเร็จ: " .. tostring(claimError))
        else
            Log("🎁 ส่งคำขอรับ Daily Reward วันที่ " .. dayKey)
        end
    end
end

local function ClaimAvailableTimeRewards()
    local timeRewards = Omni.Shared and Omni.Shared.TimeRewards
    local timeData = Omni.Data and Omni.Data.TimeRewards
    if typeof(timeRewards) ~= "table" or typeof(timeData) ~= "table"
        or typeof(timeData.Claimed) ~= "table"
        or typeof(timeData.TimePlayed) ~= "number" then
        return
    end

    for rewardIndex, rewardInfo in ipairs(timeRewards) do
        if typeof(rewardInfo) ~= "table" or typeof(rewardInfo.Time) ~= "number" then
            continue
        end

        local rewardKey = tostring(rewardIndex)
        if timeData.Claimed[rewardKey] == true then
            requestedTimeRewards[rewardKey] = nil
            continue
        end
        if rewardInfo.Time > timeData.TimePlayed then
            continue
        end
        if requestedTimeRewards[rewardKey] and os.clock() - requestedTimeRewards[rewardKey] < 15 then
            continue
        end

        requestedTimeRewards[rewardKey] = os.clock()
        local claimOk, claimError = pcall(function()
            Omni.Signal:Fire("General", "TimeRewards", "Claim", rewardIndex)
        end)
        if not claimOk then
            requestedTimeRewards[rewardKey] = nil
            warn("[WarpFarm] รับ Time Reward #" .. rewardKey .. " ไม่สำเร็จ: " .. tostring(claimError))
        else
            Log("⏱️ ส่งคำขอรับ Time Reward #" .. rewardKey)
        end
    end
end


-- ============================================================
-- ENEMY SCANNER & VALIDATION
-- ============================================================
-- ดึงข้อมูลมอนสเตอร์ทั้งหมดที่มีชีวิตในแมพปัจจุบัน
local function GetAllLivingEnemies()
    local currentMap = Omni.Data and Omni.Data.Maps and Omni.Data.Maps.Current
    local enemies = {}
    local seenIDs = {}

    -- 1. ดึงจาก Omni Enemy Cache โดยตรง (แม่นยำที่สุด 100%)
    pcall(function()
        local cache = Omni.Cache and Omni.Cache:Get({ "Enemies" })
        if cache and typeof(cache) == "table" then
            for id, enemyObj in pairs(cache) do
                if enemyObj and enemyObj.Data and enemyObj.Data.Health then
                    local hp = enemyObj.Data.Health.Value
                    local isDied = (enemyObj.Instance and enemyObj.Instance:GetAttribute("Died") == true)
                    
                    if hp > 0 and not isDied then
                        local cf = nil
                        if enemyObj.HRP then
                            cf = enemyObj.HRP.CFrame
                        elseif enemyObj.Data.CurrentPosition then
                            cf = enemyObj.Data.CurrentPosition.Value
                        elseif enemyObj.Instance and enemyObj.Instance:IsA("BasePart") then
                            cf = enemyObj.Instance.CFrame
                        end

                        if cf then
                            seenIDs[id] = true
                            table.insert(enemies, {
                                ID       = id,
                                Name     = enemyObj.Name or id,
                                Wrapper  = enemyObj,
                                Instance = enemyObj.Instance,
                                CFrame   = cf,
                                Health   = hp,
                                MaxHP    = (enemyObj.Data.MaxHealth and enemyObj.Data.MaxHealth.Value) or hp,
                            })
                        end
                    end
                end
            end
        end
    end)

    -- 2. Fallback: ดึงจาก CollectionService Tagged "Enemy"
    if #enemies == 0 then
        for _, part in CollectionService:GetTagged("Enemy") do
            if part:IsA("BasePart") then
                local id = part:GetAttribute("EnemyID") or part.Name
                if not seenIDs[id] then
                    local data = part:FindFirstChild("Data")
                    local hpVal = data and data:FindFirstChild("Health")
                    local isDied = part:GetAttribute("Died") == true

                    if hpVal and hpVal.Value > 0 and not isDied then
                        local mapName = part:GetAttribute("MapName")
                        if not currentMap or not mapName or mapName == currentMap then
                            seenIDs[id] = true
                            table.insert(enemies, {
                                ID       = id,
                                Name     = part:GetAttribute("EnemyName") or part.Name,
                                Instance = part,
                                CFrame   = part.CFrame,
                                Health   = hpVal.Value,
                                MaxHP    = hpVal.Value,
                            })
                        end
                    end
                end
            end
        end
    end

    -- 3. Fallback: ดึงจาก workspace.Client.Enemies
    if #enemies == 0 then
        local clientEnemies = workspace:FindFirstChild("Client") and workspace.Client:FindFirstChild("Enemies")
        if clientEnemies then
            for _, model in clientEnemies:GetChildren() do
                if model:IsA("Model") then
                    local id = model:GetAttribute("EnemyID") or model.Name
                    if not seenIDs[id] then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        local hum = model:FindFirstChildWhichIsA("Humanoid")
                        local isDied = model:GetAttribute("Died") == true

                        if hrp and not isDied and (not hum or hum.Health > 0) then
                            seenIDs[id] = true
                            table.insert(enemies, {
                                ID       = id,
                                Name     = model.Name,
                                Instance = model,
                                CFrame   = hrp.CFrame,
                                Health   = (hum and hum.Health) or 100,
                                MaxHP    = (hum and hum.MaxHealth) or 100,
                            })
                        end
                    end
                end
            end
        end
    end

    return enemies
end

-- หามอนตัวที่ใกล้ตำแหน่งเราที่สุด
local function FindNearestEnemy(enemies)
    local hrp = GetHRP()
    if not hrp or #enemies == 0 then return nil end

    local myPos = hrp.Position
    local nearest = nil
    local minDist = math.huge

    for _, e in enemies do
        local dist = (e.CFrame.Position - myPos).Magnitude
        if dist < minDist then
            minDist = dist
            nearest = e
        end
    end

    return nearest
end

-- ============================================================
-- ATTACK EXECUTION
-- ============================================================
local lastFighterOrderTarget
local lastFighterOrderAt = 0

local function Attack(target)
    if not farmEnabled or not target then return end

    if target.ID then
        local fighters
        local playerStats = Omni.Utils and Omni.Utils.PlayerStats

        if playerStats and playerStats.GetAvailableFightersForTarget then
            local availableOk, availableResult = pcall(function()
                return playerStats.GetAvailableFightersForTarget(target.ID, Omni.Data, LP)
            end)
            if availableOk and typeof(availableResult) == "table" then
                fighters = availableResult
            elseif not availableOk then
                warn("[WarpFarm] ตรวจสอบนักสู้ที่พร้อมโจมตีไม่สำเร็จ: " .. tostring(availableResult))
            end
        else
            fighters = GetEquippedFighters()
        end

        local now = os.clock()
        if fighters and #fighters > 0
            and (target.ID ~= lastFighterOrderTarget or now - lastFighterOrderAt >= 1) then
            local attackOk, attackError = pcall(function()
                Omni.Signal:Invoke("General", "Combat", "FighterAttack", target.ID, fighters)
            end)
            if attackOk then
                lastFighterOrderTarget = target.ID
                lastFighterOrderAt = now
            else
                warn("[WarpFarm] ส่งนักสู้ไปโจมตีไม่สำเร็จ: " .. tostring(attackError))
            end
        end
    end

    -- 2. ปล่อย Weapon Skill อัตโนมัติ
    if CFG.AutoSkill then
        pcall(function()
            Omni.Signal:Fire("General", "Combat", "WeaponSkill")
        end)
    end

    -- 3. ยิง ClickDetector ถ้ามี
    pcall(function()
        if fireclickdetector and target.Instance then
            local cd = target.Instance:FindFirstChildWhichIsA("ClickDetector")
                or target.Instance:FindFirstChild("ClickDetector", true)
            if cd then
                fireclickdetector(cd)
            end
        end
    end)
end


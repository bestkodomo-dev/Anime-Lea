local function CreateDropdown(name, yPosition, selectorSize, getOptions, getSelectedName, onSelected)
    local selector = CreateActionButton(
        name,
        "",
        UDim2.fromOffset(9, yPosition),
        selectorSize,
        function() end
    )
    selector.ZIndex = 5

    local menu = Instance.new("ScrollingFrame")
    menu.Name = name .. "Options"
    menu.Position = UDim2.fromOffset(9, yPosition + 44)
    menu.Size = UDim2.new(selectorSize.X.Scale, selectorSize.X.Offset, 0, 0)
    menu.BackgroundColor3 = Color3.fromRGB(16, 15, 13)
    menu.BorderSizePixel = 0
    menu.ScrollBarThickness = 4
    menu.CanvasSize = UDim2.fromOffset(0, 0)
    menu.Visible = false
    menu.ZIndex = 20
    menu.Parent = contentFrame

    local menuCorner = Instance.new("UICorner")
    menuCorner.CornerRadius = UDim.new(0, 4)
    menuCorner.Parent = menu

    local menuStroke = Instance.new("UIStroke")
    menuStroke.Thickness = 1
    menuStroke.Parent = menu

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 2)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = menu

    local function RefreshSelector()
        local selectedName = getSelectedName()
        selector.Text = tostring(selectedName or "No available options") .. "  ▾"
        selector.Active = selectedName ~= nil
        selector.AutoButtonColor = selectedName ~= nil
    end

    selector.Activated:Connect(function()
        if menu.Visible then
            menu.Visible = false
            return
        end

        for _, child in ipairs(menu:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        local options = getOptions()
        if #options == 0 then
            RefreshSelector()
            return
        end

        local optionHeight = 30
        menu.Size = UDim2.new(
            selectorSize.X.Scale,
            selectorSize.X.Offset,
            0,
            math.min(#options * (optionHeight + 2), 126)
        )
        menu.CanvasSize = UDim2.fromOffset(0, #options * (optionHeight + 2))
        for index, option in ipairs(options) do
            local optionButton = Instance.new("TextButton")
            optionButton.Name = "Option" .. index
            optionButton.Size = UDim2.new(1, -6, 0, optionHeight)
            optionButton.BackgroundColor3 = Color3.fromRGB(16, 15, 13)
            optionButton.BorderSizePixel = 0
            optionButton.Font = Enum.Font.GothamMedium
            optionButton.TextColor3 = Color3.fromRGB(245, 245, 245)
            optionButton.TextSize = 14
            optionButton.TextXAlignment = Enum.TextXAlignment.Left
            optionButton.Text = "  " .. tostring(option.Label)
            optionButton.LayoutOrder = index
            optionButton.ZIndex = 21
            optionButton.Parent = menu
            optionButton.Activated:Connect(function()
                onSelected(option)
                RefreshSelector()
                menu.Visible = false
            end)
        end
        menu.Visible = true
    end)

    RefreshSelector()
    return selector, RefreshSelector
end


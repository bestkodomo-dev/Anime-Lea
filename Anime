for _, child in ipairs(contentFrame:GetChildren()) do
    if not child:IsA("GuiObject") then
        continue
    end

    local categoryName = categoryForControl[child.Name]
    if not categoryName then
        warn("[WarpFarm] ไม่มีหมวด UI สำหรับ " .. child.Name)
        continue
    end
    table.insert(childrenByCategory[categoryName], child)
end

for categoryName, children in pairs(childrenByCategory) do
    table.sort(children, function(a, b)
        if a.Position.Y.Offset == b.Position.Y.Offset then
            return a.Position.X.Scale < b.Position.X.Scale
        end
        return a.Position.Y.Offset < b.Position.Y.Offset
    end)

    local page = categoryPages[categoryName]
    local yPosition = 0
    local menuPositions = {}
    for _, child in ipairs(children) do
        if child.Name:sub(-7) == "Options" then
            continue
        end

        child.Parent = page
        child.Position = UDim2.new(child.Position.X.Scale, child.Position.X.Offset, 0, yPosition)
        if child.Name == "SelectTeleportMap" or child.Name == "SelectDungeonDifficulty" then
            menuPositions[child.Name .. "Options"] = yPosition + child.Size.Y.Offset + 2
        end
        yPosition += child.Size.Y.Offset + 8
    end

    for _, child in ipairs(children) do
        if child.Name:sub(-7) == "Options" then
            child.Parent = page
            child.Position = UDim2.fromOffset(9, menuPositions[child.Name] or yPosition)
        end
    end

    page.CanvasSize = UDim2.fromOffset(0, yPosition + 8)
end

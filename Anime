local function TryJoinSelectedDungeon()
    if not autoDungeonEnabled or not selectedDungeonModeName then
        return
    end
    if Omni.Data and Omni.Data.Gamemode then
        return
    end

    local modes = GetUnlockedDungeonModes()
    local selectedMode
    for _, mode in ipairs(modes) do
        if mode.Name == selectedDungeonModeName then
            selectedMode = mode
            break
        end
    end
    if not selectedMode then
        selectedDungeonModeName = modes[1] and modes[1].Name or nil
        if not selectedDungeonModeName then
            return
        end
        selectedMode = modes[1]
    end

    local now = os.clock()
    if now - lastDungeonJoinAttempt < 8 then
        return
    end
    lastDungeonJoinAttempt = now

    local previewOk, preview = pcall(function()
        return Omni.Signal:Invoke("General", "Gamemodes", "Preview", selectedDungeonModeName)
    end)
    if not previewOk then
        warn("[WarpFarm] ตรวจสอบรอบดันเจี้ยนไม่สำเร็จ: " .. tostring(preview))
        return
    end
    if typeof(preview) ~= "table"
        or preview.GamemodeName ~= selectedDungeonModeName
        or preview.Status ~= "Opened"
        or typeof(preview.EntryClosesAt) ~= "number"
        or workspace:GetServerTimeNow() >= preview.EntryClosesAt then
        if lastDungeonStatusMessageAt == 0 or os.clock() - lastDungeonStatusMessageAt >= 30 then
            lastDungeonStatusMessageAt = os.clock()
            local status = typeof(preview) == "table" and preview.Status or "unavailable"
            Log("🏰 รอรอบดันเจี้ยนเปิดรับ (" .. tostring(selectedMode.Difficulty) .. ", สถานะ: " .. tostring(status) .. ")")
        end
        return
    end

    local selectedInfo = Omni.Shared.Gamemodes.List[selectedDungeonModeName]
    if not selectedInfo or not IsMapUnlocked(selectedInfo.MapName) then
        warn("[WarpFarm] แมพของดันเจี้ยนนี้ยังไม่ปลดล็อก")
        return
    end

    local joinOk, joined = pcall(function()
        return Omni.Signal:Invoke("General", "Gamemodes", "Join", selectedDungeonModeName)
    end)
    if not joinOk then
        warn("[WarpFarm] เข้าโหมดดันเจี้ยนไม่สำเร็จ: " .. tostring(joined))
        return
    end
    if joined then

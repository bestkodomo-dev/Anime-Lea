local function UpgradeSelectedLevelStat()
    if not autoLevelEnabled then
        return
    end

    local playerLevel = Omni.Shared and Omni.Shared.PlayerLevel
    local levelData = Omni.Data and Omni.Data.Level
    local stats = playerLevel and playerLevel.List and playerLevel.List.Stats
    if not playerLevel or not levelData or not stats or not stats[selectedLevelStat] then
        local invalidStatKey = "invalid:" .. tostring(selectedLevelStat)
        if lastAutoUpgradeKey ~= invalidStatKey then
            warn("[WarpFarm] ไม่พบข้อมูลสเตตัสที่เลือก: " .. tostring(selectedLevelStat))
            lastAutoUpgradeKey = invalidStatKey
        end
        return
    end

    local pointsOk, availablePoints = pcall(function()
        return playerLevel.GetAvailablePoints(Omni.Data)
    end)
    if not pointsOk then
        warn("[WarpFarm] อ่านแต้มเลเวลที่เหลือไม่สำเร็จ: " .. tostring(availablePoints))
        return
    end
    if typeof(availablePoints) ~= "number" or availablePoints <= 0 then
        return
    end

    local currentStatPoints = levelData.Stats[selectedLevelStat] or 0
    local upgradeKey = table.concat({
        tostring(levelData.Amount),
        selectedLevelStat,
        tostring(currentStatPoints),
        tostring(availablePoints)
    }, ":")
    if upgradeKey == lastAutoUpgradeKey then
        return
    end

    local upgradeOk, upgradeError = pcall(function()
        Omni.Signal:Fire("General", "PlayerLevel", "UpgradeStat", selectedLevelStat, availablePoints)
    end)
    if not upgradeOk then
        warn("[WarpFarm] อัปค่าสเตตัสอัตโนมัติไม่สำเร็จ: " .. tostring(upgradeError))
        return
    end

    lastAutoUpgradeKey = upgradeKey
    Log(string.format("📈 ลงแต้มเลเวล %d แต้มให้ %s", availablePoints, selectedLevelStat))
end

local function GetOwnedMaps()
    local maps = Omni.Shared and Omni.Shared.Maps and Omni.Shared.Maps.List
    if typeof(maps) ~= "table" then
        return {}
    end

    local ownsMap = Omni.Utils and Omni.Utils.PlayerStats and Omni.Utils.PlayerStats.OwnsMap
    local currentMap = Omni.Data and Omni.Data.Maps and Omni.Data.Maps.Current
    local availableMaps = {}
    for mapName, mapInfo in pairs(maps) do
        local owned = mapName == currentMap
        if not owned and ownsMap then
            local ownsOk, ownsResult = pcall(function()
                return ownsMap(mapName, Omni.Data)
            end)
            if not ownsOk then
                warn("[WarpFarm] ตรวจสอบสิทธิ์แมพ " .. tostring(mapName) .. " ไม่สำเร็จ: " .. tostring(ownsResult))
            else
                owned = ownsResult == true
            end
        end

        if owned then
            table.insert(availableMaps, {
                Name = mapName,
                Index = mapInfo.Index or math.huge
            })
        end
    end

    table.sort(availableMaps, function(a, b)
        if a.Index == b.Index then
            return a.Name < b.Name
        end
        return a.Index < b.Index
    end)
    return availableMaps
end

local function IsMapUnlocked(mapName)
    if typeof(mapName) ~= "string" or mapName == "" then
        return false
    end

    local currentMap = Omni.Data and Omni.Data.Maps and Omni.Data.Maps.Current
    if mapName == currentMap then
        return true
    end

    local ownsMap = Omni.Utils and Omni.Utils.PlayerStats and Omni.Utils.PlayerStats.OwnsMap
    if not ownsMap then
        return false
    end

    local ownsOk, ownsResult = pcall(function()
        return ownsMap(mapName, Omni.Data)
    end)
    if not ownsOk then
        warn("[WarpFarm] ตรวจสอบสิทธิ์แมพ " .. tostring(mapName) .. " ไม่สำเร็จ: " .. tostring(ownsResult))
        return false
    end
    return ownsResult == true
end

local function GetUnlockedDungeonModes()
    local gamemodes = Omni.Shared and Omni.Shared.Gamemodes and Omni.Shared.Gamemodes.List
    if typeof(gamemodes) ~= "table" then
        return {}
    end

    local modes = {}
    for modeName, modeInfo in pairs(gamemodes) do
        if typeof(modeInfo) == "table"
            and modeInfo.Type == "Dungeon"
            and modeInfo.Style == "Scheduled"
            and IsMapUnlocked(modeInfo.MapName) then
            table.insert(modes, {
                Name = modeName,
                Difficulty = modeInfo.Difficulty or "Unknown"
            })
        end
    end

    table.sort(modes, function(a, b)
        local order = Omni.Shared.Gamemodes.DifficultyOrder or {}
        local aIndex = table.find(order, a.Difficulty) or math.huge
        local bIndex = table.find(order, b.Difficulty) or math.huge
        if aIndex == bIndex then
            return a.Name < b.Name
        end
        return aIndex < bIndex
    end)
    return modes
end

local function GetUnlockedGachas()
    local gachas = Omni.Shared and Omni.Shared.Gacha and Omni.Shared.Gacha.List
    if typeof(gachas) ~= "table" then
        return {}
    end

    local result = {}
    for gachaName, gachaInfo in pairs(gachas) do
        if typeof(gachaInfo) == "table"
            and typeof(gachaInfo.Source) == "table"
            and gachaInfo.Source.Type == "Normal"
            and (not gachaInfo.Map or IsMapUnlocked(gachaInfo.Map)) then
            table.insert(result, {
                Name = gachaName,
                Cost = gachaInfo.Price and gachaInfo.Price.Amount,
                Currency = gachaInfo.Price and gachaInfo.Price.Name
            })
        end
    end

    table.sort(result, function(a, b)
        return a.Name < b.Name
    end)
    return result
end

local function SetAutoGachaEnabled(enabled)
    local gachas = GetUnlockedGachas()
    local selectedIsAvailable = false
    for _, gachaInfo in ipairs(gachas) do
        if gachaInfo.Name == selectedGachaName then
            selectedIsAvailable = true
            break
        end
    end

    if enabled and not selectedIsAvailable then
        selectedGachaName = gachas[1] and gachas[1].Name or nil
        if not selectedGachaName then
            warn("[WarpFarm] ไม่พบกาชาที่ปลดล็อกแล้ว")
            return false
        end
    end

    if enabled then
        local startOk, startError = pcall(function()
            Omni.Signal:FireSelf("Interface", "Gacha", "Resume", selectedGachaName)
        end)
        if not startOk then
            autoGachaEnabled = false
            warn("[WarpFarm] เริ่มหมุนกาชาอัตโนมัติไม่สำเร็จ: " .. tostring(startError))
            return false
        end
        autoGachaEnabled = true
        Log("🎰 เปิด Auto Gacha: " .. tostring(selectedGachaName))
    else
        local stopOk, stopError = pcall(function()
            Omni.Signal:FireSelf("Interface", "Gacha", "Stop")
        end)
        if not stopOk then
            warn("[WarpFarm] หยุดหมุนกาชาอัตโนมัติไม่สำเร็จ: " .. tostring(stopError))
            return false
        end
        autoGachaEnabled = false
        Log("⏸️ ปิด Auto Gacha")
    end
end

